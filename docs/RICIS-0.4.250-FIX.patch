diff --git a/src/ricisSeed/classicalEvaluator.ts b/src/ricisSeed/classicalEvaluator.ts
index 154bc5e..f0e8589 100644
--- a/src/ricisSeed/classicalEvaluator.ts
+++ b/src/ricisSeed/classicalEvaluator.ts
@@ -1,28 +1,39 @@
 import { FormNode } from './canonicalForm';
-import { DOUBLE_EPSILON, isMachineZero } from '../model/ricisEpsilon';
+
+const DOUBLE_EPSILON: number = Number.EPSILON;
+
+function isMachineZero(value: number, epsilon: number = DOUBLE_EPSILON): boolean {
+  return Math.abs(value) <= epsilon;
+}
+
+function deterministic01(symbol: string, trial: number): number {
+  let hash = 0;
+  for (let i = 0; i < symbol.length; i++) hash = (hash * 31 + symbol.charCodeAt(i)) >>> 0;
+  const mixed = (hash + trial * 0x9e3779b1) >>> 0;
+  return (mixed % 1000000) / 1000000;
+}
 
 /**
  * Heuristic numerical equivalence checker for classical algebraic steps.
- * Assigns random values to symbols and evaluates both sides.
+ * Assigns deterministic values to symbols and evaluates both sides.
  */
 export function verifyClassicalEquivalence(from: FormNode, to: FormNode): boolean {
   const symbols = new Set<string>();
   collectSymbols(from, symbols);
   collectSymbols(to, symbols);
 
-  // Perform multiple trials with different random values to reduce collision probability
+  // Perform multiple trials with different deterministic values to reduce collision probability
   for (let trial = 0; trial < 5; trial++) {
     const vars: Record<string, number> = {};
     for (const sym of symbols) {
-      // Use primes or non-trivial floats to avoid accidental integer coincidences
-      vars[sym] = 2.718 + Math.random() * 10 + (trial * 1.618);
+      vars[sym] = 2.718 + deterministic01(sym, trial) * 10 + trial * 1.618;
     }
 
     const valFrom = evaluateNumerical(from, vars);
     const valTo = evaluateNumerical(to, vars);
 
     if (valFrom === undefined || valTo === undefined) return false;
-    
+
     // Check for machine epsilon relative match
     const diff = Math.abs(valFrom - valTo);
     const scale = Math.max(Math.abs(valFrom), Math.abs(valTo), 1.0);
@@ -55,20 +66,20 @@ function collectSymbols(node: FormNode, symbols: Set<string>): void {
 function evaluateNumerical(node: FormNode, vars: Record<string, number>): number | undefined {
   switch (node.kind) {
     case 'id':
-      // Treat numeric strings as numbers
       if (/^-?\d+(\.\d+)?$/.test(node.name)) return parseFloat(node.name);
       return vars[node.name];
     case 'call': {
       const arg = evaluateNumerical(node.arg, vars);
       if (arg === undefined) return undefined;
-      // Handle special RICIS tokens as large/small values for numerical check
       if (node.name === 'inf_' || node.name === 'inf') return (1 / DOUBLE_EPSILON) * arg;
       if (node.name === '0_' || node.name === '0') return DOUBLE_EPSILON * arg;
-      
-      // Standard math functions
-      const fn = (Math as any)[node.name];
-      if (typeof fn === 'function') return fn(arg);
-      
+
+      const fnUnknown = (Math as unknown as Record<string, unknown>)[node.name];
+      if (typeof fnUnknown === 'function') {
+        const fn = fnUnknown as (x: number) => number;
+        return fn(arg);
+      }
+
       return undefined;
     }
     case 'pow': {
